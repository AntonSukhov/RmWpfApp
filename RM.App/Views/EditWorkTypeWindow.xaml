<Window x:Class="RM.App.Views.EditWorkTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RM.App.ViewModels"
        Width="460"
        Loaded="OnLoaded"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        SnapsToDevicePixels="True"
        Title="{Binding WindowTitle}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance Type=vm:EditWorkTypeWindowViewModel, IsDesignTimeCreatable=False}"
        mc:Ignorable="d">
    
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
      
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
      
    <!-- Название -->
    <Label Content="_Название вида работ:"
           Margin="0,0,12,8"
           VerticalAlignment="Center"
           Padding="0"
           Target="{Binding ElementName=NameTextBox}"
           Grid.Column="0"
           Grid.Row="0" />
      
    <TextBox x:Name="NameTextBox"
             Margin="0,0,0,8"
             VerticalAlignment="Center"
             Grid.Column="1"
             Grid.Row="0" 
             MaxLength="200" 
             Text="{Binding WorkTypeName, Mode=TwoWay}"/>
      
    <!-- Единица работ -->
    <Label Content="_Единица работ:"
           Margin="0,0,12,16"
           VerticalAlignment="Center"
           Padding="0"
           Target="{Binding ElementName=WorkUnitComboBox}"
           Grid.Column="0"
           Grid.Row="1" />
      
    <ComboBox   Grid.Column="1"
                Grid.Row="1"
                x:Name="WorkUnitComboBox"
                Margin="0,0,0,16"
                VerticalAlignment="Center"
                DisplayMemberPath="Name"
                ItemsSource="{Binding WorkUnits, Mode=OneWay}"
                SelectedItem="{Binding SelectedWorkUnit, Mode=TwoWay}"/>
      
    <!-- Кнопки -->
    <StackPanel HorizontalAlignment="Right"
                Orientation="Horizontal"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="2">
        
      <Button Content="Сохранить"
              Margin="0,0,8,0"
              IsDefault="True"
              MinWidth="75" 
              Command="{Binding SaveWorkTypeCommand}"/>
        
      <Button Content="Отмена" 
              IsCancel="True" 
              MinWidth="75" />
    </StackPanel>
  </Grid>
</Window>