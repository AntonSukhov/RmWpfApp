<Window x:Class="RM.App.Views.EditWorkTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RM.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:EditWorkTypeWindowViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0"
               Grid.Column="0"
               Content="_Название вида работ:"
               Target="{Binding ElementName=NameTextBox}"
               Padding="0"
               VerticalAlignment="Center"
               Margin="0,0,12,8"/>

        <TextBox x:Name="NameTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 MinWidth="250"
                 VerticalAlignment="Center"
                 Margin="0,0,0,8"/>

        <Label Grid.Row="1"
               Grid.Column="0"
               Content="_Единица работ:"
               Target="{Binding ElementName=WorkUnitComboBox}"
               Padding="0"
               VerticalAlignment="Center"
               Margin="0,0,12,16"/>

        <ComboBox x:Name="WorkUnitComboBox"
                  Grid.Row="1"
                  Grid.Column="1"
                  MinWidth="250"
                  VerticalAlignment="Center"
                  Margin="0,0,0,16"/>

        <StackPanel Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Сохранить"
                    IsDefault="True"
                    MinWidth="75"
                    Margin="0,0,8,0"/>

            <Button Content="Отмена"
                    IsCancel="True"
                    MinWidth="75"/>

        </StackPanel>
    </Grid>
</Window>
