<UserControl x:Class="RM.App.Views.WorkTypesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="clr-namespace:Infrastructure.Wpf.Interactivity;assembly=Infrastructure.Wpf"
        xmlns:vm="clr-namespace:RM.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:WorkTypesViewModel, IsDesignTimeCreatable=False}"
        d:DesignHeight="450" d:DesignWidth="800" Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Действия">
                <MenuItem   Header="Обновить список видов работ" 
                            ToolTip="Получить актуальные виды работ из сервиса"
                            Command="{Binding ReloadWorkTypesCommand}"/>
                
                <MenuItem   Header="Создать вид работ" 
                            ToolTip="Создать вид работ"
                            Command="{Binding CreateWorkTypeCommand}"/>
            </MenuItem>
            <MenuItem Header="Окно"/>
            <MenuItem Header="Справка">
                <MenuItem Header="О модуле"/>
            </MenuItem>
        </Menu>

        <ToolBarTray Grid.Row="1">
            <ToolBar>
                <Button Command="{Binding ReloadWorkTypesCommand}" 
                        ToolTip="Получить актуальные виды работ из сервиса">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳" 
                           FontSize="16" 
                           VerticalAlignment="Center" 
                           Margin="0,-2,0,0"/>
                        <TextBlock Text="Обновить список" 
                           VerticalAlignment="Center" 
                           Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>

                <Separator />
                
                <Button Command="{Binding CreateWorkTypeCommand}" 
                        ToolTip="Создать вид работ">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  Text="+" 
                                    FontSize="18" 
                                    VerticalAlignment="Center" 
                                    Margin="0,-2,0,0"/>
                        
                        <TextBlock  Text="Создать вид работ" 
                                    VerticalAlignment="Center" 
                                    Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                
                
            </ToolBar>
        </ToolBarTray>

        <DataGrid   Grid.Row="2" 
                    IsReadOnly="True" 
                    SelectionMode="Extended"
                    SelectionUnit="Cell"
                    i:LoadingAdornerHelper.IsLoading="{Binding IsLoading}"
                    ItemsSource="{Binding WorkTypes, Mode=OneWay}"
                    AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ИД вида работ" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Название вида работ" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="ИД единицы работ" Binding="{Binding WorkUnit.Id}"/>
                <DataGridTextColumn Header="Название единицы работ" Binding="{Binding WorkUnit.Name}"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem   Header="Обновить список" 
                                Command="{Binding ReloadWorkTypesCommand}" 
                                ToolTip="Получить актуальные виды работ из сервиса"/>
                    
                    <MenuItem   Header="Создать вид работ" 
                                Command="{Binding CreateWorkTypeCommand}" 
                                ToolTip="Создать новый вид работ"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

        </DataGrid>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding WorkTypes.Count, Mode=OneWay, StringFormat='Количество строк: {0}'}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
