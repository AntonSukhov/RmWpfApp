{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Framework Launch",
            "type": "clr",
            "request": "launch",
            "program": "${workspaceFolder}/RM.App/bin/Debug/RM.App.exe",
            "cwd": "${workspaceFolder}/RM.App/bin/Debug",
            "console": "externalTerminal",
            "stopAtEntry": false,
            "preLaunchTask": "Build Debug"
        },
        {
            "name": ".NET Framework Attach",
            "type": "clr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
